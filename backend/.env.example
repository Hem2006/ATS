# Copy this file to backend/.env and fill in real values.
# The agent selects the first provider that has a non-empty key.

# Preferred: fast + free tier available
GROQ_API_KEY=

# Fallback #1
OPENAI_API_KEY=

# Fallback #2 (used if the others are empty)
GEMINI_API_KEY=

# SMTP (optional — needed only for actually sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Stitch ATS

FRONTEND_URL=http://localhost:5173
